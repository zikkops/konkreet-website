# Copy to .env.local and fill in. Without DATABASE_URL the site renders
# from src/data/content.ts and the admin panel is unavailable.

# Neon → your project → Connect → connection string (starts with postgresql://)
DATABASE_URL=

# ImageKit → Dashboard → Developer options → API keys, and URL endpoints
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
